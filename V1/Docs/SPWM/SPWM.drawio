        <mxCell id="BQfLmcwhFBj1v4yusZEq-16" value="quy đổi sang khoảng, truyền" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="620" width="120" height="60" as="geometry" />
