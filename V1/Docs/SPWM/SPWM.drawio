        </mxCell>
        <mxCell id="BQfLmcwhFBj1v4yusZEq-2" value="Bắt đầu" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="360" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="BQfLmcwhFBj1v4yusZEq-3" value="Khởi tạo điện áp tham chiếu" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="220" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BQfLmcwhFBj1v4yusZEq-5" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Khởi tạo điện áp tham chiếu&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Tạo 3 điện áp tham chiếu có tần số là 50Hz, điện áp +-10V&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Tần số sóng mang là 20kHz (50us), tần số sóng sin tham chiếu là 50Hz (20ms)&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;=&amp;gt; 20m/50u = 400&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Tạo bảng sine có 400 điểm&lt;/span&gt;&lt;/li&gt;&lt;li&gt;Tạo bảng sine có nửa chu kỳ đầu là có giá trị, nửa chu kỳ sau là bằng 0, vì duty cycle ở bán kỳ âm hình sine là không đáng kể.&lt;/li&gt;&lt;li&gt;Dịch chuyển 2 pha, tạo điện áp tham chiếu 3 pha&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="480" y="140" width="320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="BQfLmcwhFBj1v4yusZEq-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" target="BQfLmcwhFBj1v4yusZEq-7">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="480" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BQfLmcwhFBj1v4yusZEq-7" value="Tính hệ số nhiệm vụ" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="520" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="BQfLmcwhFBj1v4yusZEq-8" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Tính hệ số nhiệm vụ&amp;nbsp;&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;duty cycle = Value of Sine Table x Tpwm&lt;br&gt;&lt;div&gt;duty1 = VU/10.0 * Ts;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;duty2 = VV/10.0 * Ts;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;duty3 = VW/10.0 * Ts;&lt;/span&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="510" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="BQfLmcwhFBj1v4yusZEq-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="580" as="sourcePoint" />
            <mxPoint x="400" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BQfLmcwhFBj1v4yusZEq-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" target="BQfLmcwhFBj1v4yusZEq-16">
          <mxGeometry relative="1" as="geometry">
