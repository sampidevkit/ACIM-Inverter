        <mxCell id="BQfLmcwhFBj1v4yusZEq-17" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Tính hệ số nhiệm vụ, quy đổi, truyền&lt;/h1&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Quy đổi sang khoảng từ 0 đến 2999&lt;/span&gt;&lt;/div&gt;&lt;div&gt;McOutputs&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
