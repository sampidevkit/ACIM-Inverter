        <mxCell id="BQfLmcwhFBj1v4yusZEq-24" value="MC_myProcess(),&lt;div&gt;t++&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="421" width="120" height="60" as="geometry" />
